# Appearance
theme                = light:Codemos Modern (Light),dark:Codemos Modern (Dark) 
palette-generate     = true
macos-icon           = custom
macos-custom-icon    = ~/.config/ghostty/icons/Ghostty.icns
window-theme         = system
window-width         = 96
window-height        = 32
window-step-resize   = true
window-padding-x     = 12
window-padding-y     = 0
window-padding-color = extend
macos-titlebar-style = tabs
background-opacity   = 0
background-blur      = macos-glass-regular
font-family          = Cascadia Code NF
font-size            = 14

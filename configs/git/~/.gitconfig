[user]
  name = Emrecan Karaçayır

[init]
  defaultBranch = main

[includeIf "gitdir:~/Developer/Projects/External/github.com/"]
  path = ~/.config/git/GitHub/.gitconfig

[ghq]
  root = ~/Developer/Projects/External/

[gpg "ssh"]
  program = ~/.local/bin/ssh-sign
  allowedSignersFile = ~/.config/git/allowed_signers

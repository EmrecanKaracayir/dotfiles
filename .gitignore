*

# >----------------< INCLUDES >----------------< #

# [+]: Git files
!.gitignore

# [+]: Repo files
!LICENSE.md
!README.md

# [+]: Source files
!apps/
!apps/**
!configs/
!configs/**
!packages/
!packages/**

# [+]: Config files
!.editorconfig

# >----------------< EXCLUDES >----------------< #

# [-]: macOS files
.DS_Store
**/.DS_Store

# [-]: SSH private keys (only public keys are tracked)
configs/ssh/~/.ssh/keys/**
!configs/ssh/~/.ssh/keys/**/
!configs/ssh/~/.ssh/keys/**/*.pub
